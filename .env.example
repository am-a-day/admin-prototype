# Tasko admin API credentials for the one-off catalog import script.
# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Used by: node --env-file=.env.local scripts/import-catalog-fixture.mjs
TASKO_LOGIN=
TASKO_PASSWORD=

# Optional isolated public demo mode for the Pragmatic catalog preview.
VITE_PRAGMATIC_CATALOG_PREVIEW=
VITE_CATALOG_STORAGE_NAMESPACE=
